# Placeholder values only. Copy this file to .env and fill in real values locally.
# Never commit .env.

# AI calls are routed through Portkey (required).
PORTKEY_API_KEY=your-portkey-api-key-here

# Only needed for direct OpenAI calls that bypass Portkey (optional).
OPENAI_API_KEY=

# Model used by the shopping assistant agent.
OPENAI_MODEL=gpt-5.6-luna

# Optional Portkey routing overrides (defaults shown).
# PORTKEY_BASE_URL=https://api.portkey.ai/v1
# PORTKEY_PROVIDER=openai

# Signs login session cookies. Use a long random value, e.g. python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=replace-with-a-long-random-string

# Optional: where the AI audit trail is written (default: <data folder>/audit/audit_log.jsonl, git-ignored).
# AUDIT_LOG_PATH=

# Set to true when the site is served over HTTPS so the session cookie is only sent securely.
COOKIE_SECURE=false

# Optional: provided test account, used only by local tests. Never commit real values.
TEST_ACCOUNT_EMAIL=
TEST_ACCOUNT_PASSWORD=
